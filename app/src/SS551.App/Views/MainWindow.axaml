<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="using:KD.Avalonia.Rice.Controls"
                 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons"
                 xmlns:vm="using:SS551.App.ViewModels"
                 x:Class="SS551.App.Views.MainWindow"
                 x:DataType="vm:MainViewModel"
                 x:Name="Root"
                 Icon="/Assets/icon.png"
                 Title="Redragon SS-551"
                 ShowThemeSettingsButton="True" ShowAboutButton="True"
                 Width="1240" Height="820" MinWidth="1040" MinHeight="640">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource RiceForegroundMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource RiceForegroundMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource RiceForegroundMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.stage">
            <Setter Property="BorderBrush" Value="{DynamicResource RiceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="rice|RiceGroupBox">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.mini icons|MaterialIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!-- Deck tiles: border shows selection (accent) and live input (yellow). -->
        <Style Selector="Button.tile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RiceBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource RiceBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource RiceForegroundMutedBrush}" />
            <Setter Property="Background" Value="{DynamicResource RiceSurfaceAltBrush}" />
        </Style>
        <Style Selector="Button.tile.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource RiceAccentBrush}" />
        </Style>
        <Style Selector="Button.tile.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#FDD835" />
        </Style>

        <Style Selector="Ellipse.status">
            <Setter Property="Fill" Value="{DynamicResource RiceDangerBrush}" />
        </Style>
        <Style Selector="Ellipse.status.on">
            <Setter Property="Fill" Value="#43A047" />
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- One macro step. -->
        <DataTemplate DataType="vm:ActionViewModel">
            <StackPanel Spacing="8">
                <ComboBox ItemsSource="{x:Static vm:ActionViewModel.ActionTypes}"
                          SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" />

                <StackPanel IsVisible="{Binding IsHotkey}" Spacing="4">
                    <TextBox Text="{Binding Hotkey}" PlaceholderText="e.g. Ctrl+Alt+T, Super+E, F5" />
                    <TextBlock Text="{Binding HotkeyError}" Foreground="{DynamicResource RiceDangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HotkeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <ComboBox IsVisible="{Binding IsMedia}" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Static vm:ActionViewModel.MediaActions}"
                          SelectedItem="{Binding Media}" />

                <TextBox IsVisible="{Binding IsCommand}" Text="{Binding Command}"
                         PlaceholderText="Shell command, e.g. gnome-calculator" />

                <TextBox IsVisible="{Binding IsOpen}" Text="{Binding Target}"
                         PlaceholderText="URL, file or folder, e.g. https://… or ~/Documents" />

                <StackPanel IsVisible="{Binding IsPage}" Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{x:Static vm:ActionViewModel.PageActions}"
                              SelectedItem="{Binding Page}" MinWidth="120" />
                    <NumericUpDown IsVisible="{Binding IsPageGoTo}" Value="{Binding PageNumber}"
                                   Minimum="1" Increment="1" FormatString="0" MinWidth="120" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBrightness}" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Change by (%)" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding BrightnessStep}" Minimum="-100" Maximum="100"
                                   Increment="5" FormatString="0" MinWidth="120" />
                </StackPanel>

                <Grid IsVisible="{Binding IsApp}" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding AppName}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Choose…" Margin="6,0,0,0" Click="OnChooseAppForStep" />
                </Grid>

                <StackPanel IsVisible="{Binding IsDelay}" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Wait (ms)" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding DelayMs}" Minimum="0" Maximum="600000"
                                   Increment="100" FormatString="0" MinWidth="140" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Macro: ordered steps with reorder/remove and an add button. -->
        <DataTemplate DataType="vm:MacroViewModel">
            <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActionViewModel">
                            <Border Classes="step">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Text="{Binding Number, StringFormat=Step {0}}"
                                                   Classes="caption" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="mini" ToolTip.Tip="Move up"
                                                Command="{Binding $parent[ItemsControl].((vm:MacroViewModel)DataContext).MoveUpCommand}"
                                                CommandParameter="{Binding}">
                                            <icons:MaterialIcon Kind="ArrowUp" />
                                        </Button>
                                        <Button Grid.Column="2" Classes="mini" ToolTip.Tip="Move down"
                                                Command="{Binding $parent[ItemsControl].((vm:MacroViewModel)DataContext).MoveDownCommand}"
                                                CommandParameter="{Binding}">
                                            <icons:MaterialIcon Kind="ArrowDown" />
                                        </Button>
                                        <Button Grid.Column="3" Classes="mini" ToolTip.Tip="Remove step"
                                                Command="{Binding $parent[ItemsControl].((vm:MacroViewModel)DataContext).RemoveStepCommand}"
                                                CommandParameter="{Binding}">
                                            <icons:MaterialIcon Kind="Close" />
                                        </Button>
                                    </Grid>
                                    <ContentControl Content="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" Text="Nothing happens." IsVisible="{Binding IsEmpty}" />
                <Button Command="{Binding AddStepCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="Plus" />
                        <TextBlock Text="Add step" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- Short press + accumulating long-press stages. -->
        <DataTemplate DataType="vm:PressViewModel">
            <rice:RiceGroupBox Header="{Binding Title}" Icon="{x:Static mi:MaterialIconKind.GestureTap}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="hint" IsVisible="{Binding HasStages}" TextWrapping="Wrap"
                               Text="Runs on release, only if the key was let go before the first long-press stage." />
                    <ContentControl Content="{Binding Short}" />

                    <ItemsControl ItemsSource="{Binding Stages}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HoldStageViewModel">
                                <Border Classes="stage">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <TextBlock Classes="section" VerticalAlignment="Center"
                                                       Text="{Binding Number, StringFormat=Long press {0}: hold +}" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding Seconds}" Minimum="0.1"
                                                           Maximum="600" Increment="0.5" FormatString="0.0#"
                                                           Width="120" Margin="6,0" />
                                            <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                                       Text="{Binding AtSeconds, StringFormat=s → at {0:0.0#} s}" />
                                            <Button Grid.Column="3" Classes="mini" ToolTip.Tip="Remove stage"
                                                    Command="{Binding $parent[ItemsControl].((vm:PressViewModel)DataContext).RemoveStageCommand}"
                                                    CommandParameter="{Binding}">
                                                <icons:MaterialIcon Kind="Close" />
                                            </Button>
                                        </Grid>
                                        <ContentControl Content="{Binding Actions}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding AddStageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <icons:MaterialIcon Kind="TimerPlusOutline" />
                            <TextBlock Text="Add long-press stage" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="hint" TextWrapping="Wrap"
                               Text="Each stage's time is added to the previous one; every stage reached while holding runs." />
                </StackPanel>
            </rice:RiceGroupBox>
        </DataTemplate>

        <!-- One key look: title, icon, colours. -->
        <DataTemplate DataType="vm:AppearanceViewModel">
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="Title (Enter for a new line)" />
                <TextBox Text="{Binding Title}" AcceptsReturn="True" MaxHeight="80" />

                <TextBlock Classes="label" Text="Icon" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Text="{Binding IconPath}" PlaceholderText="PNG, JPEG or SVG file" />
                    <Button Grid.Column="1" Content="File…" Margin="6,0,0,0" Click="OnBrowseIcon" />
                    <Button Grid.Column="2" Content="App…" Margin="6,0,0,0" Click="OnIconFromApp"
                            ToolTip.Tip="Use an installed application's icon" />
                    <Button Grid.Column="3" Classes="mini" Margin="6,0,0,0" Click="OnClearIcon"
                            ToolTip.Tip="Remove icon">
                        <icons:MaterialIcon Kind="Close" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Background" />
                        <ColorPicker Color="{Binding BackgroundColor}" IsAlphaEnabled="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="label" Text="Text colour" />
                        <ColorPicker Color="{Binding TextColor}" IsAlphaEnabled="False" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:KeyViewModel">
            <StackPanel Spacing="6">
                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnChooseAppForKey"
                        ToolTip.Tip="Show the app's icon on the key and launch the app when pressed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="Apps" />
                        <TextBlock Text="Choose application…" />
                    </StackPanel>
                </Button>
                <!-- Off / on previews -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <Border CornerRadius="10" ClipToBounds="True" Width="72" Height="72">
                            <Image Source="{Binding Look.Preview}" />
                        </Border>
                        <TextBlock Classes="caption" HorizontalAlignment="Center"
                                   Text="{Binding HasState, Converter={x:Static vm:Converters.OffLabel}}" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding HasState}">
                        <Border CornerRadius="10" ClipToBounds="True" Width="72" Height="72">
                            <Image Source="{Binding OnLook.Preview}" />
                        </Border>
                        <TextBlock Classes="caption" HorizontalAlignment="Center" Text="On" />
                    </StackPanel>
                </StackPanel>

                <rice:RiceGroupBox Header="Look" Icon="{x:Static mi:MaterialIconKind.PaletteOutline}">
                    <ContentControl Content="{Binding Look}" />
                </rice:RiceGroupBox>

                <rice:RiceGroupBox Header="State indicator" Icon="{x:Static mi:MaterialIconKind.ToggleSwitchOutline}">
                    <StackPanel Spacing="6">
                        <ComboBox ItemsSource="{x:Static vm:KeyViewModel.StateSources}"
                                  SelectedItem="{Binding StateSource}" HorizontalAlignment="Stretch" />
                        <TextBlock Classes="hint" Text="{Binding StateHint}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasState}" />
                        <StackPanel IsVisible="{Binding IsCommandSource}" Spacing="6">
                            <TextBox Text="{Binding StateCommand}" PlaceholderText="e.g. pgrep -x obs" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Check every (s)" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding IntervalSeconds}" Minimum="0.2" Maximum="3600"
                                               Increment="0.5" FormatString="0.0#" MinWidth="130" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding HasState}" Spacing="6">
                            <TextBlock Classes="section" Text="Look while on" Margin="0,8,0,0" />
                            <ContentControl Content="{Binding OnLook}" />
                            <CheckBox IsChecked="{Binding SeparateOnPress}" Margin="0,6,0,0"
                                      Content="Run a different action while on" />
                        </StackPanel>
                    </StackPanel>
                </rice:RiceGroupBox>

                <ContentControl Content="{Binding Press}" />
                <ContentControl Content="{Binding OnPress}" IsVisible="{Binding ShowOnPress}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:ButtonViewModel">
            <StackPanel Spacing="6">
                <TextBlock Classes="hint" Text="Same on every page." />
                <ContentControl Content="{Binding Press}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:KnobViewModel">
            <StackPanel Spacing="6">
                <TextBlock Classes="hint" Text="Same on every page. Turning runs the macro once per step." />
                <rice:RiceGroupBox Header="Turn left" Icon="{x:Static mi:MaterialIconKind.RotateLeft}">
                    <ContentControl Content="{Binding Left}" />
                </rice:RiceGroupBox>
                <rice:RiceGroupBox Header="Turn right" Icon="{x:Static mi:MaterialIconKind.RotateRight}">
                    <ContentControl Content="{Binding Right}" />
                </rice:RiceGroupBox>
                <ContentControl Content="{Binding Press}" />
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- Title bar: connection status and deck brightness. -->
    <rice:RiceWindow.TitleBarContent>
        <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Right" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="status" Classes.on="{Binding IsConnected}" Width="10" Height="10"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <icons:MaterialIcon Kind="Brightness6" Width="18" Height="18" VerticalAlignment="Center"
                                    ToolTip.Tip="Brightness" />
                <Slider Width="140" Minimum="0" Maximum="100" TickFrequency="5" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" Value="{Binding Brightness}" />
                <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" Width="40"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </rice:RiceWindow.TitleBarContent>

    <Grid ColumnDefinitions="*,460">
        <DockPanel>
            <!-- Event log -->
            <rice:RiceCard DockPanel.Dock="Bottom" Header="Event log" Height="190" Margin="24,0,24,20"
                           Icon="{x:Static mi:MaterialIconKind.TextBoxOutline}" Padding="8,0,8,8">
                <rice:RiceCard.HeaderActions>
                    <Button Classes="mini" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear">
                        <icons:MaterialIcon Kind="DeleteSweepOutline" />
                    </Button>
                </rice:RiceCard.HeaderActions>
                <ListBox ItemsSource="{Binding Log}" FontFamily="monospace" FontSize="12"
                         Background="Transparent" />
            </rice:RiceCard>

            <!-- Deck -->
            <StackPanel Margin="24,20" Spacing="18">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Page" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Width="170">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageItemViewModel">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Text="{Binding SelectedPage.Name}" Width="170" PlaceholderText="Page name" />
                    <Button Command="{Binding AddPageCommand}" ToolTip.Tip="Add page">
                        <icons:MaterialIcon Kind="Plus" />
                    </Button>
                    <Button Command="{Binding RemovePageCommand}" IsEnabled="{Binding CanRemovePage}"
                            ToolTip.Tip="Remove page">
                        <icons:MaterialIcon Kind="Minus" />
                    </Button>
                </StackPanel>

                <rice:RiceCard HorizontalAlignment="Left" Elevation="2" CornerRadius="22" Padding="22">
                    <Grid ColumnDefinitions="Auto,36,Auto">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding Keys}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyViewModel">
                                        <Button Classes="tile" Classes.selected="{Binding IsSelected}"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                                            <Image Source="{Binding Preview}" Width="96" Height="96" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Buttons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ButtonViewModel">
                                        <Button Classes="tile" Classes.selected="{Binding IsSelected}"
                                                Classes.active="{Binding IsActive}" Height="40"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).SelectCommand}"
                                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                                            <TextBlock Text="{Binding Press.Summary}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="6,0" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Knobs: big one on top, the two small ones below. -->
                        <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Center">
                            <Button Classes="tile" Classes.selected="{Binding Knobs[0].IsSelected}"
                                    Classes.active="{Binding Knobs[0].IsActive}"
                                    Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                                    Command="{Binding SelectCommand}" CommandParameter="{Binding Knobs[0]}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Knobs[0].Name}" HorizontalAlignment="Center" FontSize="12" />
                                    <TextBlock Text="{Binding Knobs[0].Left.Summary, StringFormat=◀ {0}}" Classes="caption"
                                               HorizontalAlignment="Center" FontSize="10" />
                                    <TextBlock Text="{Binding Knobs[0].Right.Summary, StringFormat=▶ {0}}" Classes="caption"
                                               HorizontalAlignment="Center" FontSize="10" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Button Classes="tile" Classes.selected="{Binding Knobs[1].IsSelected}"
                                        Classes.active="{Binding Knobs[1].IsActive}"
                                        Width="78" Height="78" CornerRadius="39"
                                        Command="{Binding SelectCommand}" CommandParameter="{Binding Knobs[1]}">
                                    <StackPanel>
                                        <TextBlock Text="Left" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Knobs[1].Left.Summary, StringFormat=◀ {0}}" FontSize="9"
                                                   Classes="caption" HorizontalAlignment="Center" MaxWidth="64"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Knobs[1].Right.Summary, StringFormat=▶ {0}}" FontSize="9"
                                                   Classes="caption" HorizontalAlignment="Center" MaxWidth="64"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="tile" Classes.selected="{Binding Knobs[2].IsSelected}"
                                        Classes.active="{Binding Knobs[2].IsActive}"
                                        Width="78" Height="78" CornerRadius="39"
                                        Command="{Binding SelectCommand}" CommandParameter="{Binding Knobs[2]}">
                                    <StackPanel>
                                        <TextBlock Text="Right" FontSize="11" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Knobs[2].Left.Summary, StringFormat=◀ {0}}" FontSize="9"
                                                   Classes="caption" HorizontalAlignment="Center" MaxWidth="64"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Knobs[2].Right.Summary, StringFormat=▶ {0}}" FontSize="9"
                                                   Classes="caption" HorizontalAlignment="Center" MaxWidth="64"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </rice:RiceCard>

                <TextBlock Classes="hint" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                           Text="Click a key, button or knob to edit it. Keys belong to the selected page; the buttons and knobs work the same on every page. Changes are saved and sent to the deck automatically." />
            </StackPanel>
        </DockPanel>

        <!-- Editor -->
        <Border Grid.Column="1" Background="{DynamicResource RiceSurfaceBrush}"
                BorderBrush="{DynamicResource RiceBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="8" Margin="18,16,24,16">
                    <TextBlock Text="{Binding Selected.Name, FallbackValue='Nothing selected'}"
                               FontSize="20" FontWeight="SemiBold" />
                    <ContentControl Content="{Binding Selected}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</rice:RiceWindow>
