<rice:RiceWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:rice="using:KD.Avalonia.Rice.Controls"
                 xmlns:vm="using:SS551.App.ViewModels"
                 x:Class="SS551.App.Views.AppPickerWindow"
                 x:DataType="vm:AppPickerViewModel"
                 Title="Choose application"
                 ShowThemeToggle="False"
                 Width="520" Height="620" MinWidth="400" MinHeight="400"
                 WindowStartupLocation="CenterOwner">

    <DockPanel Margin="14">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Text="{Binding Search}"
                 PlaceholderText="Search applications…" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Choose" Classes="accent" Click="OnChoose"
                    IsEnabled="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <rice:RiceLoadingOverlay IsActive="{Binding IsLoading}" Message="Loading applications…">
            <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}"
                     DoubleTapped="OnDoubleTapped" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Comment}" FontSize="11"
                                           Foreground="{DynamicResource RiceForegroundMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </rice:RiceLoadingOverlay>
    </DockPanel>
</rice:RiceWindow>
